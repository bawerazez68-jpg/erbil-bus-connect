# Copy this file to .env and fill in real values for local development.
# NEVER commit .env — it is gitignored. In production, set these as
# platform-managed environment variables/secrets, never in source control.

# Origin this app is served from. Used to validate CSRF (Origin header) and
# to scope cookies. Must match exactly (scheme + host + port).
APP_ORIGIN=http://localhost:3000

# HMAC secret for signing short-lived JWT access tokens.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=

# HMAC secret for signing/hashing refresh tokens. Must differ from JWT_ACCESS_SECRET.
# Generate with: openssl rand -base64 48
JWT_REFRESH_SECRET=

# 32-byte (base64) key used for AES-256-GCM encryption of sensitive data at rest
# (e.g. audit log IP addresses). Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Set to "production" to require all secrets above to be explicitly set
# (dev falls back to ephemeral in-memory secrets with a warning, so the app
# still boots without a .env file, but sessions won't survive a restart).
NODE_ENV=development
